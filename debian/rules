#!/usr/bin/make -f

export PYBUILD_NAME=mcp_email_server

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_configure:
	sed -i 's/^version = "0.0.1"/version = "1.1.0"/' pyproject.toml
	dh_auto_configure

override_dh_auto_clean:
	dh_auto_clean
	git checkout pyproject.toml 2>/dev/null || true

override_dh_auto_test:
	# Skip tests - test dependencies not packaged
